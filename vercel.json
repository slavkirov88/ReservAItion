{
  "functions": {
    "src/app/api/vapi/**": {
      "maxDuration": 30
    },
    "src/app/api/stripe/webhook": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/expire-deposits",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/sync-ical",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/clock-availability",
      "schedule": "*/15 * * * *"
    }
  ]
}
